# Cheerio reads real environment variables (this file is documentation, not auto-loaded).
# Local Ollama (default, free, no key):
#   nothing to set - defaults already point at http://localhost:11434/v1
# OpenAI API:
CHEERIO_API_BASE=https://api.openai.com/v1
CHEERIO_MODEL=gpt-4o-mini
CHEERIO_API_KEY=YOUR_KEY
# Any other OpenAI-compatible endpoint with tool calling works the same way.
